# ============ Telegram-бот ============
# Создайте бота у @BotFather и вставьте токен
BOT_TOKEN=123456:ABC-your-bot-token
# Администраторы (узнать свой ID: напишите боту /start). Несколько — через запятую
ADMIN_IDS=123456789
# Друзья: получают дайджест (после /start), но не управляют каналами. Через запятую
#ALLOWED_IDS=
# Дополнительно слать дайджест в эти чаты (id группы/канала, где бот админ)
#DIGEST_CHAT_IDS=

# ============ Расписание ============
TZ=Europe/Moscow
# Время дайджеста: одно (08:00), несколько (08:00,19:00) или интервал (06:00-21:00/3 — каждые 3 часа)
DIGEST_TIMES=08:00
# Как часто опрашивать каналы (минуты)
COLLECT_INTERVAL_MINUTES=60
# При добавлении канала — за сколько часов назад взять посты
FIRST_FETCH_HOURS=24

# ============ LLM ============
# openrouter | openai | anthropic | ollama | none
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-v1-...
# Любая модель OpenRouter, напр. google/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-haiku-5-5
LLM_MODEL=google/gemini-2.5-flash
# Для OpenAI-совместимых сервисов (DeepSeek, Groq, LM Studio, vLLM…) — свой адрес:
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://api.deepseek.com/v1
#LLM_MODEL=deepseek-chat
# Напрямую Claude:
#LLM_PROVIDER=anthropic
#LLM_API_KEY=sk-ant-...
#LLM_MODEL=claude-haiku-5-5

# ============ Обработка ============
# Посты длиннее этого (символов) сокращаются нейросетью
SUMMARY_THRESHOLD=600
SUMMARY_MAX_CHARS=350
SKIP_ADS=true
# Блок «Главное за день» в начале дайджеста
DIGEST_OVERVIEW=true
DIGEST_LANGUAGE=русский
DEFAULT_PRIORITY=2

# ============ Источник постов ============
# auto — Telethon, если заданы TG_*, иначе веб-превью t.me/s (только публичные каналы)
SOURCE=auto
# Для приватных каналов и импорта подписок (https://my.telegram.org):
#TG_API_ID=
#TG_API_HASH=
# Получить: docker run -it --rm velikoross/tgchanreader python -m tgchanreader.login
#TG_SESSION=

# ============ Веб / RSS ============
WEB_ENABLED=true
WEB_PORT=8080
# Внешний адрес — для ссылок в RSS и в дайджесте
WEB_BASE_URL=http://localhost:8080
# Если задан — доступ только с ?token=...
WEB_TOKEN=

LOG_LEVEL=INFO
